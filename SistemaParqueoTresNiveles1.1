Algoritmo SistemaParqueoTresNiveles
	
	//======================
	// DECLARACION
	//======================
	Definir opcion, nivel, i Como Entero
	Definir totalVehiculos Como Entero
	Definir mayor, nivelMayor Como Entero
	
	Dimension total[3]
	Dimension ocupados[3]
	
	//======================
	// INICIALIZACION FIJA
	//======================
	total[1] <- 8
	total[2] <- 11
	total[3] <- 6
	
	Para i <- 1 Hasta 3 Hacer
		ocupados[i] <- 0
	FinPara
	
	Escribir "===== ESPACIOS POR NIVEL ====="
	Para i <- 1 Hasta 3 Hacer
		Escribir "Nivel ", i, ": ", total[i], " espacios"
	FinPara
	
	//======================
	// MENU PRINCIPAL
	//======================
	Mientras opcion <> 4 Hacer
		
		Escribir ""
		Escribir "===== MENU ====="
		Escribir "1. Entrar vehiculo"
		Escribir "2. Salir vehiculo"
		Escribir "3. Ver estado"
		Escribir "4. Salir"
		Leer opcion
		
		Segun opcion Hacer
			
			1:
				Escribir "Ingrese nivel (1-3):"
				Leer nivel
				
				Mientras nivel < 1 Hacer
					Escribir "Nivel invalido:"
					Leer nivel
				FinMientras
				
				Mientras nivel > 3 Hacer
					Escribir "Nivel invalido:"
					Leer nivel
				FinMientras
				
				Si ocupados[nivel] < total[nivel] Entonces
					ocupados[nivel] <- ocupados[nivel] + 1
					Escribir "Vehiculo ingresado"
					Escribir "Disponibles: ", total[nivel]-ocupados[nivel]
				SiNo
					Escribir "Nivel lleno"
				FinSi
				
			2:
				Escribir "Ingrese nivel (1-3):"
				Leer nivel
				
				Mientras nivel < 1 Hacer
					Escribir "Nivel invalido:"
					Leer nivel
				FinMientras
				
				Mientras nivel > 3 Hacer
					Escribir "Nivel invalido:"
					Leer nivel
				FinMientras
				
				Si ocupados[nivel] > 0 Entonces
					ocupados[nivel] <- ocupados[nivel] - 1
					Escribir "Vehiculo retirado"
				SiNo
					Escribir "Nivel vacio"
				FinSi
				
			3:
				totalVehiculos <- 0
				
				Para i <- 1 Hasta 3 Hacer
					Escribir "Nivel ", i
					Escribir "Total: ", total[i]
					Escribir "Ocupados: ", ocupados[i]
					Escribir "Disponibles: ", total[i]-ocupados[i]
					totalVehiculos <- totalVehiculos + ocupados[i]
				FinPara
				
				Escribir "Total vehiculos: ", totalVehiculos
				
			4:
				Escribir "Gracias por usar el sistema"
				
			De Otro Modo:
				Escribir "Opcion invalida"
				
				opcion 0:
		FinSegun
		
	FinMientras
	
FinAlgoritmo

